        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A dystonia characterized by autosomal dominant inheritance of focal or segmental dystonia with cranial, cervical, or upper limb involvement that has_material_basis_in variation in the chromosome region 1p36.32-p36.13.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">disease_ontology</oboInOwl:hasOBONamespace>
