    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0090043">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_543"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A dystonia characterized by autosomal dominant inheritance of childhood-onset dystonia that responds to low doses of levodopa (L-dopa) and may be associated with parkinsonism at an older age and has_material_basis_in heterozygous mutation in the GCH1 gene on chromosome 14q13.</obo:IAO_0000115>
