    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0090044 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0090044">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_543"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A dystonia characterized by autosomal dominant inheritance of paroxysmal choreoathetosis and progressive spastic paraplegia, episodes are often precipitated by alcohol, fatigue, or emotional stress that has_material_basis_in heterozygous mutation in the SLC2A1 gene on chromosome 1p34.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">disease_ontology</oboInOwl:hasOBONamespace>
