    <!-- http://purl.obolibrary.org/obo/DOID_0090041 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0090041">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_543"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A dystonia characterized by autosomal dominant inheritance of progressive laryngeal and cervical dystonia (onset in the second to third decade of life) followed by involvement of other muscles, such as the neck or limbs that has_material_basis_in heterozygous mutation in the TUBB4A gene on chromosome 19p13.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">disease_ontology</oboInOwl:hasOBONamespace>
