        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">diaphragmatic hernia, exomphalos, absent corpus callosum, hypertelorism, myopia, sensorineural deafness, and proteinuria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">diaphragmatic hernia-exomphalos-hypertelorism syndrome</oboInOwl:hasExactSynonym>
