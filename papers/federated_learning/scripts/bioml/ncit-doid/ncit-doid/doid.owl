    <!-- http://purl.obolibrary.org/obo/DOID_0090144 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0090144">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An autosomal recessive disease characterized by facial and ocular abnormalities, sensorineural hearing loss, agenesis of the corpus callosum, variable intellectual disability, and proteinuria that has_material_basis_in homozygous or compound heterozygous mutation in the LRP2 gene on chromosome 2q31.</obo:IAO_0000115>
